{
  "name": "agent-session-bridge",
  "private": false,
  "type": "module",
  "version": "0.1.2",
  "description": "Bridge local AI coding sessions between Pi, Claude Code, Codex, OpenCode, and Omnigent. Runs on Bun.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bohdanpodvirnyi/agent-session-bridge.git"
  },
  "homepage": "https://github.com/bohdanpodvirnyi/agent-session-bridge",
  "bugs": {
    "url": "https://github.com/bohdanpodvirnyi/agent-session-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agent-session-bridge": "bin/agent-session-bridge"
  },
  "files": [
    "README.md",
    "LICENSE",
    "bin",
    "packages/*/src",
    "packages/*/package.json",
    "packages/pi/index.ts"
  ],
  "keywords": [
    "ai",
    "coding-agents",
    "claude-code",
    "codex",
    "pi",
    "session-portability",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.4.6"
  },
  "packageManager": "bun@1.4.6",
  "scripts": {
    "fixture:validate": "bun test packages/core/test/parsers.test.ts",
    "lint": "bun lint --no-script",
    "format": "bun fmt --check",
    "release:check": "bun lint --no-script && bun test && bun check .",
    "containers:build": "bun scripts/containers/build.ts",
    "test:containers": "bun scripts/containers/run.ts",
    "test:real-agents": "REAL_AGENT_E2E=1 bun test packages/core/test/e2e-real-commands.test.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bun check ."
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.48.1",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
