{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "agent-session-bridge-core": ["./packages/core/src/index.ts"]
    },
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
